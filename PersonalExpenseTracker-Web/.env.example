# ==============================================================================
# PERSONAL EXPENSE TRACKER - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================

# ==================== BACKEND (Render / Local) ====================
# Port on which the Spring Boot application will listen
PORT=8080

# Neon PostgreSQL Database Connection (replace with your Neon credentials)
# In Neon Console: Copy Connection String (Java / JDBC format):
DATABASE_URL=jdbc:postgresql://ep-example-12345.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_USERNAME=neondb_owner
DATABASE_PASSWORD=your_neon_password_here

# 256-bit Hex / Base64 Secret Key for JWT HMAC-SHA256 Token Signing
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Permitted CORS Origins (comma separated list)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://*.vercel.app

# ==================== FRONTEND (Vercel / Local) ====================
# Backend API Base URL for React Frontend (on Vercel point to your Render backend)
VITE_API_URL=/api
# In production on Vercel:
# VITE_API_URL=https://personal-expense-tracker-backend.onrender.com/api
